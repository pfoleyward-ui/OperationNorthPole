{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operation-north-pole-notifications",
  "main": "workers/notifications/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "GATEWAY_DELIVERY_ENABLED": "false",
    "REMINDER_POLICY_JSON": "{\"timeZone\":\"America/New_York\",\"morningTime\":\"08:00\",\"quietStart\":\"21:00\",\"quietEnd\":\"08:00\",\"escalationMinutes\":[0,120,240,360],\"reconcileMinutes\":15,\"sevenDayHours\":168,\"acknowledgmentHours\":24,\"finalReminderHours\":3}",
    "ELF_NOTES_ENABLED": "false",
    "ELF_RETENTION_APPROVED": "false",
    "HQ_ORIGIN": "https://hq.santablizard.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "operation-north-pole-email",
      "database_id": "2f5bf022-d088-48a8-af05-c9958be3c5a0",
      "migrations_dir": "migrations/gateway"
    },
    {
      "binding": "BOOKING_DB",
      "database_name": "operation-north-pole-booking",
      "database_id": "a2c79b9c-a578-4d0c-86c4-27f0b1e72b8c",
      "migrations_dir": "migrations"
    }
  ]
}
