{
  "name": "operation-north-pole-resend-webhook",
  "main": "workers/resend-webhook.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "RESEND_WEBHOOK_INGRESS_ENABLED": "false"
  },
  "services": [
    {
      "binding": "NOTIFY_WEBHOOK",
      "service": "operation-north-pole-notifications"
    }
  ]
}
